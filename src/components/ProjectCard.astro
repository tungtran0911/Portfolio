---
interface Props {
  title: string;
  href: string;
  blurb: string;
  tags?: string[];
  metrics?: { label: string; value: string }[];
  status?: 'live' | 'wip' | 'archived';
}

const { title, href, blurb, tags = [], metrics = [], status } = Astro.props;
const statusBadge =
  status === 'live' ? { label: 'live', className: 'border-accent/40 text-accent' }
  : status === 'wip' ? { label: 'work-in-progress', className: 'border-warn/40 text-warn' }
  : status === 'archived' ? { label: 'archived', className: 'text-muted' }
  : null;
---

<a href={href} class="card group block">
  <div class="flex items-center justify-between gap-3 mb-3">
    <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">
      {title}
    </h3>
    {statusBadge && (
      <span class={`pill ${statusBadge.className}`}>{statusBadge.label}</span>
    )}
  </div>

  <p class="text-sm text-muted leading-relaxed mb-4">{blurb}</p>

  {metrics.length > 0 && (
    <div class="grid grid-cols-3 gap-3 mb-4 py-3 border-y border-border/60">
      {metrics.slice(0, 3).map((m) => (
        <div>
          <div class="text-[10px] uppercase tracking-wider text-muted font-mono">{m.label}</div>
          <div class="font-mono text-sm font-semibold text-ink tabular-nums">{m.value}</div>
        </div>
      ))}
    </div>
  )}

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((t) => <span class="pill">{t}</span>)}
    </div>
  )}
</a>
