---
interface Props {
  label: string;
  value: string | number;
  tone?: 'default' | 'good' | 'warn' | 'bad';
}

const { label, value, tone = 'default' } = Astro.props;
const toneClass =
  tone === 'good' ? 'text-accent'
  : tone === 'warn' ? 'text-warn'
  : tone === 'bad' ? 'text-danger'
  : 'text-ink';
---

<div class="flex flex-col gap-0.5">
  <span class="metric-label">{label}</span>
  <span class={`metric-num ${toneClass}`}>{value}</span>
</div>
