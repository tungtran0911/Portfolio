---
// "Arcane night" wallpaper behind every page: a starry sky, a moon, floating candles, mist and a
// gothic castle on a cliff with candle-lit windows. All drawn here, no third-party artwork.
// The quant touch: one constellation is a random walk, a time series written in stars.
// Seeded, so every build draws the same sky. Purely decorative, hidden from assistive tech.
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(1997);
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
const f = (n: number) => n.toFixed(1);

// sky
const stars = Array.from({ length: 170 }, () => ({
  x: rand() * 1440,
  y: rand() * 620,
  r: 0.6 + rand() ** 3 * 2,
  o: 0.45 + rand() * 0.55,
  tw: rand() < 0.2,
  d: (rand() * 7).toFixed(2),
}));

// the time-series constellation: a random walk across the upper sky
const walk: { x: number; y: number }[] = [];
let wy = 150;
for (let i = 0; i < 15; i++) {
  walk.push({ x: 90 + i * 72, y: wy });
  wy = Math.min(300, Math.max(70, wy + gauss() * 30));
}

// castle on a cliff: [centre x, width, top y, roof height]
const towers: [number, number, number, number][] = [
  [612, 20, 238, 34],
  [668, 26, 196, 46],
  [716, 22, 222, 38],
  [770, 30, 176, 52],
  [826, 22, 150, 44],
  [888, 40, 96, 92],
  [952, 26, 140, 50],
  [1004, 34, 166, 56],
  [1058, 22, 190, 40],
  [1110, 30, 168, 48],
  [1160, 20, 226, 34],
];
const hall = { x0: 840, x1: 990, top: 196 };
const wallTop = 246;
const base = 290;

const windows: { x: number; y: number; h: number }[] = [];
for (const [cx, w, top] of towers) {
  const n = 1 + Math.floor(rand() * 3);
  for (let k = 0; k < n; k++) {
    windows.push({ x: cx - 2 + (rand() - 0.5) * (w * 0.4), y: top + 14 + k * 22 + rand() * 6, h: 7 });
  }
}
for (let k = 0; k < 6; k++) windows.push({ x: hall.x0 + 16 + k * 24, y: hall.top + 18, h: 22 });

const crenels = Array.from({ length: Math.floor((1180 - 590) / 14) }, (_, i) => 590 + i * 14);

// floating candles, kept to the two edges so they never sit behind text: left %, top %, scale, seconds, delay
const lanes = [
  [1.5, 4], [4.5, 22], [8, 9], [11, 30], [6, 40],
  [86, 7], [89.5, 26], [93, 12], [96, 34], [90.5, 42],
];
const candles = lanes.map(([x, y]) => ({
  x: (x + rand() * 1.5).toFixed(1),
  y: (y + rand() * 4).toFixed(1),
  s: (0.55 + rand() * 0.6).toFixed(2),
  dur: (6 + rand() * 5).toFixed(2),
  delay: (-rand() * 8).toFixed(2),
}));
---

<div class="backdrop arcane" aria-hidden="true">
  <svg class="arcane__sky" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMin slice">
    <defs>
      <radialGradient id="moon-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" style="stop-color: var(--color-moon); stop-opacity: 0.32" />
        <stop offset="100%" style="stop-color: var(--color-moon); stop-opacity: 0" />
      </radialGradient>
    </defs>
    <circle cx="1190" cy="150" r="190" fill="url(#moon-halo)" />
    <circle class="arcane__moon" cx="1190" cy="150" r="48" />
    <g class="arcane__craters">
      <circle cx="1176" cy="138" r="9" />
      <circle cx="1206" cy="166" r="6" />
      <circle cx="1196" cy="128" r="4" />
    </g>
    <g class="arcane__stars">
      {stars.map((s) => (
        <circle class:list={{ tw: s.tw }} cx={f(s.x)} cy={f(s.y)} r={s.r.toFixed(2)} style={`--o: ${s.o.toFixed(2)}; --d: ${s.d}s`} />
      ))}
    </g>
    <polyline class="arcane__walk" points={walk.map((p) => `${f(p.x)},${f(p.y)}`).join(' ')} />
    <g class="arcane__walk-stars">
      {walk.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r="2.4" />)}
    </g>
  </svg>

  <div class="arcane__candles">
    {candles.map((c) => (
      <span class="candle" style={`--x: ${c.x}%; --y: ${c.y}%; --s: ${c.s}; --dur: ${c.dur}s; --delay: ${c.delay}s`}><i></i></span>
    ))}
  </div>

  <svg class="arcane__land" viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
    <defs>
      <filter id="window-glow" x="-200%" y="-200%" width="500%" height="500%">
        <feGaussianBlur stdDeviation="3" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <path class="arcane__far" d="M0 300 L110 252 L230 286 L360 218 L500 276 L620 236 L760 262 L900 214 L1050 258 L1190 222 L1320 262 L1440 236 V420 H0 Z" />
    <rect class="arcane__lake" x="0" y="350" width="1440" height="70" />
    <g class="arcane__reflections">
      {windows.filter((_, i) => i % 2 === 0).map((w) => <rect x={f(w.x)} y={f(354 + (350 - w.y) * 0.2)} width="3" height="14" />)}
    </g>
    <g class="arcane__castle">
      <path d="M0 350 L0 318 Q200 300 430 306 L430 350 Z" />
      <path d="M1440 350 L1440 326 Q1360 312 1290 322 L1260 350 Z" />
      <path d="M520 350 L560 314 L590 290 L1180 290 L1215 314 L1250 350 Z" />
      <rect x="590" y={wallTop} width="590" height={base - wallTop} />
      {crenels.map((x) => <rect x={x} y={wallTop - 8} width="8" height="9" />)}
      <rect x={hall.x0} y={hall.top} width={hall.x1 - hall.x0} height={wallTop - hall.top + 1} />
      <path d={`M${hall.x0} ${hall.top} L${(hall.x0 + hall.x1) / 2} ${hall.top - 34} L${hall.x1} ${hall.top} Z`} />
      {towers.map(([cx, w, top, roof]) => (
        <g>
          <rect x={cx - w / 2} y={top} width={w} height={base - top} />
          <path d={`M${cx - w / 2 - 4} ${top} L${cx} ${top - roof} L${cx + w / 2 + 4} ${top} Z`} />
        </g>
      ))}
      <path d="M430 304 Q475 286 520 304 Q555 288 590 298 L590 308 L430 308 Z" />
    </g>
    <g class="arcane__windows" filter="url(#window-glow)">
      {windows.map((w) => <rect x={f(w.x)} y={f(w.y)} width="4" height={w.h} rx="2" />)}
    </g>
  </svg>

  <div class="arcane__mist"></div>
</div>
