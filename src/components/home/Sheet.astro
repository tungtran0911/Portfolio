---
// A modal sheet. `drawer` slides in from the right; `lightbox` centres a large image.
// Opened by any element with data-sheet="<id>" (see SheetController.astro).
interface Props {
  id: string;
  title: string;
  kicker?: string;
  variant?: 'drawer' | 'lightbox';
  /** Study slug: this title morphs into the study page heading when you follow its link. */
  study?: string;
}

const { id, title, kicker, variant = 'drawer', study } = Astro.props;
---

<dialog class:list={['sheet', `sheet--${variant}`]} id={`sheet-${id}`} aria-labelledby={`sheet-${id}-title`}>
  <div class="sheet__panel" data-sheet-panel>
    <header class="sheet__head">
      <div>
        {kicker && <p class="sheet__kicker" data-sheet-kicker>{kicker}</p>}
        <h2 class="sheet__title" id={`sheet-${id}-title`} data-sheet-title data-study-src={study}>{title}</h2>
      </div>
      <button class="sheet__close" type="button" data-sheet-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>
    <div class="sheet__body">
      <slot />
    </div>
  </div>
</dialog>
