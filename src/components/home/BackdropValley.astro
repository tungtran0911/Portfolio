---
// Wallpaper: the autumn valley with a steam train on a viaduct (the user's pick), under a navy scrim.
// As you scroll, the photo slides up, so the page reads as a journey: misty sky, the train, the river.
// On top: an owl that crosses the sky now and then, a few floating candles at the edges, and one
// faint dashed constellation that is a random walk (the quant touch). Decorative, hidden from AT.
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(1997);
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());

const walk: string[] = [];
let wy = 130;
for (let i = 0; i < 15; i++) {
  walk.push(`${90 + i * 72},${wy.toFixed(1)}`);
  wy = Math.min(260, Math.max(60, wy + gauss() * 26));
}

// below the fixed top bar, in the side lanes
const lanes = [
  [2, 22], [6, 40], [10, 30],
  [88, 26], [92, 44], [96, 34],
];
const candles = lanes.map(([x, y]) => ({
  x: (x + rand() * 1.5).toFixed(1),
  y: (y + rand() * 4).toFixed(1),
  s: (0.5 + rand() * 0.5).toFixed(2),
  dur: (6 + rand() * 5).toFixed(2),
  delay: (-rand() * 8).toFixed(2),
}));
---

<div class="backdrop valley" aria-hidden="true">
  <picture class="valley__photo">
    <source media="(max-width: 40rem)" srcset="/img/bg-valley-800.webp" type="image/webp" />
    <img src="/img/bg-valley.webp" alt="" width="1200" height="1808" decoding="async" fetchpriority="low" />
  </picture>
  <div class="valley__scrim"></div>

  <svg class="valley__walk" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMin slice">
    <polyline points={walk.join(' ')} />
  </svg>

  <div class="arcane__candles">
    {candles.map((c) => (
      <span class="candle" style={`--x: ${c.x}%; --y: ${c.y}%; --s: ${c.s}; --dur: ${c.dur}s; --delay: ${c.delay}s`}><i></i></span>
    ))}
  </div>

  <div class="owl">
    <svg class="owl__body" viewBox="0 0 120 80">
      <g class="owl__wing owl__wing--l"><path d="M50 36 C40 22 22 18 8 26 C4 29 4 34 9 35 C5 38 5 42 10 43 C7 46 9 50 14 49 C26 50 40 50 50 48 Z" /></g>
      <g class="owl__wing owl__wing--r"><path d="M70 36 C80 22 98 18 112 26 C116 29 116 34 111 35 C115 38 115 42 110 43 C113 46 111 50 106 49 C94 50 80 50 70 48 Z" /></g>
      <ellipse cx="60" cy="47" rx="13" ry="17" />
      <circle cx="60" cy="28" r="12" />
      <path d="M50 21 L48 11 L55 18 Z M70 21 L72 11 L65 18 Z" />
      <circle class="owl__face" cx="55.5" cy="28" r="5" />
      <circle class="owl__face" cx="64.5" cy="28" r="5" />
      <circle class="owl__eye" cx="55.5" cy="28" r="2.3" />
      <circle class="owl__eye" cx="64.5" cy="28" r="2.3" />
      <path class="owl__beak" d="M58.6 32 L61.4 32 L60 35.5 Z" />
    </svg>
  </div>
</div>
