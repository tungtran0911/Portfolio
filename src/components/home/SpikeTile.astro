---
// SPY realised volatility, Feb to Jun 2020, drawn so the March spike breaks out of its tile,
// the way the statue breaks out of the frame in the reference. Cyan is my HAR-QLIKE forecast.
import data from '@/data/spy-vol-crash.json';

const W = 600;
const H = 520;
const tile = { x: 30, y: 150, w: 540, h: 340 };
const n = data.dates.length;
const x = (i: number) => 64 + (i / (n - 1)) * 472;
const y = (v: number) => 462 - v * 2.07;
const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
const peak = data.actual.reduce((b, v, i) => (v > data.actual[b] ? i : b), 0);
---

<svg class="spike" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="SPY volatility in 2020. Realised volatility spikes to 196% on 16 March, high above the frame; the HAR-QLIKE forecast tracks it below.">
  <rect class="spike__tile" x={tile.x} y={tile.y} width={tile.w} height={tile.h} rx="28" />
  <g class="spike__grid">
    {[0, 50].map((v) => <line x1={tile.x + 24} x2={tile.x + tile.w - 24} y1={y(v)} y2={y(v)} />)}
  </g>
  <path class="spike__real" d={path(data.actual)} />
  <path class="spike__model draw" d={path(data.har_qlike)} pathLength="1" />
  <circle class="spike__peak" cx={x(peak)} cy={y(data.actual[peak])} r="6" />
  <text class="spike__label" x={x(peak) + 14} y={y(data.actual[peak]) + 5}>16 Mar 2020 · σ 196%</text>
  <text class="spike__axis" x={tile.x + 24} y={tile.y + tile.h - 18}>Feb</text>
  <text class="spike__axis" x={tile.x + tile.w - 24} y={tile.y + tile.h - 18} text-anchor="end">Jun 2020</text>
</svg>
