---
// Math × Computer Science × Economics. Each region lists what I actually use there.
const W = 640;
const H = 590;
const r = 175;
const A = { x: 235, y: 205 }; // mathematics
const B = { x: 405, y: 205 }; // computer science
const C = { x: 320, y: 352 }; // economics & finance

const regions = [
  { x: 150, y: 165, lines: ['Hypothesis tests', 'Bootstrap', 'PLS-SEM'] },
  { x: 490, y: 165, lines: ['Python · C++', 'Java · SQL', 'pytest · Docker'] },
  { x: 320, y: 470, lines: ['CAPM', 'Microstructure', 'Trading costs'] },
  { x: 320, y: 130, lines: ['Gradient descent', 'Custom losses'] },
  { x: 222, y: 318, lines: ['Time series', 'HAR · GARCH'] },
  { x: 418, y: 318, lines: ['Market data', 'pipelines'] },
];
---

<figure class="venn">
  <div class="chart" role="img" aria-label="Venn diagram of mathematics, computer science and economics. Quant research sits in the overlap of all three. Mathematics only: hypothesis tests, bootstrap, PLS-SEM. Computer science only: Python, C++, Java, SQL, pytest, Docker. Economics only: CAPM, microstructure, trading costs. Mathematics and computer science: gradient descent, custom losses. Mathematics and economics: time series, HAR, GARCH. Computer science and economics: market data pipelines.">
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <circle class="venn__c venn__c--a" cx={A.x} cy={A.y} r={r} />
      <circle class="venn__c venn__c--b" cx={B.x} cy={B.y} r={r} />
      <circle class="venn__c venn__c--c" cx={C.x} cy={C.y} r={r} />
      <g class="venn__labels">
        <text x={A.x - 120} y={A.y - r + 6} text-anchor="middle">Mathematics</text>
        <text x={B.x + 120} y={B.y - r + 6} text-anchor="middle">Computer Science</text>
        <text x={C.x} y={C.y + r + 36} text-anchor="middle">Economics &amp; Finance</text>
      </g>
      <g class="venn__items">
        {regions.map((g) => (
          <text x={g.x} y={g.y - (g.lines.length - 1) * 10} text-anchor="middle">
            {g.lines.map((l, k) => <tspan x={g.x} dy={k ? 20 : 0}>{l}</tspan>)}
          </text>
        ))}
      </g>
      <text class="venn__core" x="320" y="262" text-anchor="middle">Quant</text>
    </svg>
  </div>
</figure>
